# ===== AI (OpenAI-compatible) =====
# รองรับทุกค่ายที่ใช้ schema เดียวกัน — ไม่ใส่ก็ได้ ทุกหน้าจะใช้ "โหมดตัวอย่าง"
#
# ▸ Gemini (Google AI Studio) — แนะนำ (มีเครดิตฟรี):
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
#
# ▸ GLM (Z.ai):
#   AI_BASE_URL=https://api.z.ai/api/paas/v4
#   AI_MODEL=glm-4.7
#
# ▸ OpenAI:
#   AI_BASE_URL=https://api.openai.com/v1
#   AI_MODEL=gpt-4o-mini

# ===== Admin Console =====
# รหัสผ่านเข้าหน้า /admin (เปลี่ยนเป็นรหัสของตัวเอง!)
ADMIN_CODE=stocklens-admin

# ===== LINE Broadcast (ใช้ใน /admin — ส่งข้อความถึงผู้ติดตาม) =====
# สร้าง LINE Official Account (ฟรี) → เปิด Messaging API → คัดลอก "Channel access token"
# https://console.developers.line.biz
LINE_CHANNEL_ACCESS_TOKEN=

# ===== ข้อมูลธุรกิจ (แสดงบนหน้า /pricing) =====
NEXT_PUBLIC_PROMPTPAY_NAME=StockLens
NEXT_PUBLIC_PROMPTPAY_ID=08x-xxx-xxxx
NEXT_PUBLIC_FB_STARTER_URL=
NEXT_PUBLIC_FB_PRO_URL=

# ----- Database (Upstash Redis — จำเป็นเมื่อ deploy Vercel ให้ระบบสมาชิกใช้ได้จริง) -----
# สมัคร upstash.com ฟรี → สร้าง Database → คัดลอกจากหน้า Details
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ----- Cron (Flash Report อัตโนมัติรายชั่วโมง — ดู SETUP-EXTERNALS.md) -----
# ข้อความสุ่มกันคนแปลกหน้า: openssl rand -hex 16
CRON_SECRET=

# ----- Alpaca (real-time US — เผื่ออนาคต ยังไม่ได้ต่อใช้) -----
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
